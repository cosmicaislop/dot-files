#!/bin/bash
CHEZMOI_DIR=$(chezmoi source-path)

# error if working tree is dirty
if ! git -C "$CHEZMOI_DIR" diff --quiet || ! git -C "$CHEZMOI_DIR" diff --cached --quiet; then
  echo "error: working tree is dirty, commit or stash changes first"
  exit 1
fi

dconf dump /org/gnome/shell/extensions/ > "$CHEZMOI_DIR/gnome-extensions.conf"
dconf dump /org/gnome/desktop/interface/ > "$CHEZMOI_DIR/gnome-interface.conf"

THEME=$(gsettings get org.gnome.shell.extensions.user-theme name | tr -d "'")
sed -i "s/user-theme name .*/user-theme name '$THEME'/" "$CHEZMOI_DIR/run_once_restore-gnome-settings.sh.tmpl"

cd "$CHEZMOI_DIR"
git add .
git commit -m "update gnome settings"
git push
