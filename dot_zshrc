setopt autocd # Auto cd when you type in a directory name
setopt autopushd pushdignoredups # Enable pushd
setopt hist_ignore_all_dups # remove older duplicate entries from history
setopt hist_reduce_blanks # remove superfluous blanks from history items
setopt inc_append_history # save history entries as soon as they are entered
setopt share_history # share history between different instances of the shell
setopt auto_list # automatically list choices on ambiguous completion
setopt auto_menu # automatically use menu completion
setopt always_to_end # move cursor to end if word had one match
setopt ignore_eof # Stop quitting when I accidentally press ctrl-d

# The following lines were added by compinstall
zstyle ':completion:*' completer _complete _ignored _approximate
zstyle ':completion:*' matcher-list '' 'm:{[:lower:]}={[:upper:]}' 'm:{[:lower:][:upper:]}={[:upper:][:lower:]}' 'r:|[._-]=** r:|=**'
# Visual menu you can navigate with arrow keys
zstyle ':completion:*' menu select
# Color ls-style colors in file completions
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
# Group completions by category with headers
zstyle ':completion:*' group-name ''
zstyle ':completion:*:descriptions' format '%F{yellow}-- %d --%f'

# Cache completions (big speed boost for things like git, dnf)
zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path ~/.zsh/cache

# Smarter kill completion — shows process list
zstyle ':completion:*:*:kill:*:processes' list-colors '=(#b) #([0-9]#)*=0=01;31'
zstyle :compinstall filename '/Users/nihaldayal/.zshrc'
autoload -Uz compinit
compinit
# End of lines added by compinstall

# Variables
export EDITOR=nvim
export GOPATH=$HOME/go
export PATH=$PATH:$GOPATH/bin
export PATH=$PATH:$HOME/.cargo/bin
export PATH=$PATH:$HOME/.local/bin

# Source in extra config
[ -f $HOME/.aliases ] && source $HOME/.aliases
[ -f $HOME/.workrc ] && source $HOME/.workrc
[ -f $HOME/.fzf.zsh ] && source $HOME/.fzf.zsh


# FZF config
[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh
export FZF_DEFAULT_COMMAND='rg --files --follow --no-ignore-vcs --hidden -g "!{node_modules/*,.git/*,*.terraform/*}"'

# Run Starship
eval "$(starship init zsh)"

